# Placeholders only. CLI reads exported environment; it never auto-loads a .env file.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2896
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=minimax_sdd
# Use the David-goldenman/powercontext competition fork at 1be152d62a4c6df59709f15b184c6b93085fb76f.
PYTHONPATH=/absolute/path/to/powercontext/src
# Only needed for a later explicitly authorized real model run:
MINIMAX_API_KEY=REPLACE_WITH_USER_PROVIDED_KEY
MINIMAX_MODEL=REPLACE_WITH_MODEL_ENABLED_FOR_YOUR_EXISTING_PLAN
MINIMAX_API_URL=https://api.minimax.cn/v1/chat/completions
# Set to 1 only after confirming usable existing MiniMax quota; never buy quota here.
MINIMAX_QUOTA_CONFIRMED=0
